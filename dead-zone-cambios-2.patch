+    def _tilt_frame(self, frame, flipped, angle):
+        """Piernas fijas; cabeza, torso y arma giran sobre la cadera."""
+        if abs(angle) < 1:
+            return frame
+
+        key = (id(frame), round(angle))
+        cached = self._tilt_cache.get(key)
+        if cached is not None:
+            return cached
