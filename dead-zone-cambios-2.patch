+        hy = settings.TORSO_HIP[1] * s
+
+        if flipped:
+            hx = w - hx
+            angle = -angle
+
+        out = pygame.Surface((w, h), pygame.SRCALPHA)
+
+        legs = frame.copy()
+        legs.fill((0, 0, 0, 0), pygame.Rect(0, 0, w, cut))
